{
  "name": "dsh-mobile-fix",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Mobile UI patch for the DeepSeek Harness Web UI: iOS auto-zoom fix, sidebar drawer, edge swipes, phone-sized Settings and a full-screen right panel.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "license": "MIT",
  "author": "Sven <https://github.com/zven73>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "ios",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zven73/dsh-mobile-ui.git"
  },
  "homepage": "https://github.com/zven73/dsh-mobile-ui#readme",
  "bugs": {
    "url": "https://github.com/zven73/dsh-mobile-ui/issues"
  },
  "scripts": {
    "test": "node --test test/",
    "lint": "npx --yes eslint@8 --no-eslintrc --env browser,es2022 --parser-options=ecmaVersion:2022 --rule '{\"no-unused-vars\":\"error\",\"no-shadow\":\"warn\"}' lib/client.js"
  }
}
